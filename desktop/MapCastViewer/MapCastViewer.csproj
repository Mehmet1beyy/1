<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MapCastViewer</AssemblyName>
    <RootNamespace>MapCastViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Video çözme/oynatma (ffmpeg içerir) -->
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <!-- WiFi tarama / bağlanma (Native WiFi API sarmalayıcısı) -->
    <PackageReference Include="ManagedNativeWifi" Version="2.1.0" />
  </ItemGroup>

</Project>
