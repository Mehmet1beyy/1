<Window x:Class="MapCastViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MapCast Viewer" Height="720" Width="1120"
        Background="#0E1512">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol panel: bağlantı adımları -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="MapCast Viewer" Foreground="#E6F2EC" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Telefonun sanal ekranını WiFi üzerinden izle" Foreground="#8FB3A3" TextWrapping="Wrap" Margin="0,2,0,12" />

            <TextBlock Text="1) Telefonun WiFi ağı" Foreground="#7CE0B0" FontWeight="Bold" Margin="0,8,0,4" />
            <Button x:Name="BtnScan" Content="Ağları Tara" Click="BtnScan_Click" Padding="8,4" />
            <ListBox x:Name="LstNetworks" Height="120" Margin="0,6,0,0"
                     Background="#16211C" Foreground="#E6F2EC" />
            <TextBlock Text="Parola" Foreground="#8FB3A3" Margin="0,8,0,2" />
            <PasswordBox x:Name="TxtWifiPass" />
            <Button x:Name="BtnWifiConnect" Content="WiFi'a Bağlan" Click="BtnWifiConnect_Click"
                    Margin="0,6,0,0" Padding="8,4" Background="#1E8E5A" Foreground="#0E1512" />

            <TextBlock Text="2) Yayın" Foreground="#7CE0B0" FontWeight="Bold" Margin="0,16,0,4" />
            <TextBlock Text="Telefon IP" Foreground="#8FB3A3" />
            <TextBox x:Name="TxtIp" Text="192.168.49.1" />
            <TextBlock Text="PIN" Foreground="#8FB3A3" Margin="0,6,0,0" />
            <TextBox x:Name="TxtPin" />
            <Button x:Name="BtnPlay" Content="Yayını Aç" Click="BtnPlay_Click"
                    Margin="0,8,0,0" Padding="8,6" Background="#1E8E5A" Foreground="#0E1512" FontWeight="Bold" />

            <TextBlock Text="3) Web adresi (sanal ekrana)" Foreground="#7CE0B0" FontWeight="Bold" Margin="0,16,0,4" />
            <TextBox x:Name="TxtUrl" Text="youtube.com" />
            <Button x:Name="BtnGo" Content="Web'i Aç" Click="BtnGo_Click"
                    Margin="0,6,0,0" Padding="8,4" Background="#1E8E5A" Foreground="#0E1512" />

            <TextBlock x:Name="TxtStatus" Text="Hazır" Foreground="#8FB3A3"
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>

        <!-- Sağ: video + fare kontrol katmanı -->
        <Border Grid.Column="1" Background="Black" CornerRadius="6">
            <vlc:VideoView x:Name="Video">
                <!-- Neredeyse saydam katman: video üstünde fare olaylarını yakalar -->
                <Border x:Name="InputLayer" Background="#01000000" Cursor="SizeAll" />
            </vlc:VideoView>
        </Border>
    </Grid>
</Window>
