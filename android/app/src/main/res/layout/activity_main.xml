<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MapCast"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sanal ekrandaki harita görüntüsünü WiFi üzerinden laptopa yayınlar."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand"
            android:text="Yayını Başlat"
            android:textColor="@color/bg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/panel"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="Hazır"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="En kolay yol: telefonu ve laptopu AYNI WiFi'a bağla → laptopta uygulamaya yukarıdaki IP + PIN'i gir → Yayını Aç. (Hotspot açılabilirse SSID/parola da kullanılabilir.)"
            android:textColor="@color/muted"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
